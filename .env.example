# Generated from packages/config/src/env.ts — do not edit by hand.
# Regenerate with: pnpm --filter @repo/config generate:env
# Copy to .env for local development.

# Runtime mode.
# Optional; the default is shown.
# NODE_ENV=development

# Minimum level for structured logs.
# Optional; the default is shown.
# LOG_LEVEL=info

# Interface the API server binds to.
# Optional; the default is shown.
# API_HOST=127.0.0.1

# TCP port the API server listens on.
# Optional; the default is shown.
# API_PORT=3000

# PostgreSQL connection as the application role (app_runtime): no superuser, no BYPASSRLS. The example matches docker-compose.yml.
# Required.
DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:5432/app

# PostgreSQL connection as the schema owner (app_owner). Used only by pnpm db:migrate; the API and worker never use it.
# Optional.
DATABASE_MIGRATION_URL=postgres://app_owner:app_owner@127.0.0.1:5432/app

# Redis connection string. The example matches docker-compose.yml.
# Required.
REDIS_URL=redis://127.0.0.1:6379

# PostgreSQL connection as the identity role (app_auth): the auth schema only, no tenant data. The example matches docker-compose.yml.
# Required.
DATABASE_AUTH_URL=postgres://app_auth:app_auth@127.0.0.1:5432/app

# Secret that signs session cookies and encrypts TOTP secrets. At least 32 characters; generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))". Never commit it.
# Required.
AUTH_SECRET=

# Public base URL of the API, where the /api/auth endpoints are served.
# Required.
AUTH_BASE_URL=http://127.0.0.1:3000

# Origin of the web app. Cookie-authenticated requests from any other origin are refused.
# Required.
WEB_ORIGIN=http://localhost:5173

# Credential vault master key: base64 of 32 random bytes. Supply it from the process environment or a secret manager, never from a file; it is never logged.
# Required.
VAULT_MASTER_KEY=

# Identifier of the current vault master key, recorded with every credential.
# Required.
VAULT_MASTER_KEY_ID=local-dev-1

# Requests per minute allowed to each API key, counted in Redis.
# Optional; the default is shown.
# API_KEY_RATE_LIMIT_PER_MINUTE=60

# Directory for the local content-addressed payload store (development). Relative paths resolve from the working directory.
# Optional.
CONTENT_STORE_DIR=./data/content-store

# Whether collectors whose source licence is UNVERIFIED may run. BLOCKED sources never run. Unset: allowed in development and test, refused in production.
# Optional.
COLLECTORS_ALLOW_UNVERIFIED=

# Prefix of every job queue's Redis keys, so deployments sharing one Redis stay apart.
# Optional; the default is shown.
# QUEUE_PREFIX=jobs

# Queues this worker pool consumes, comma-separated: investigations, fusion, collect.<source>, collect.* for every source, or * for all.
# Optional; the default is shown.
# WORKER_QUEUES=*

# The bulkhead: the most collector jobs of one source that run at once, across every worker.
# Optional; the default is shown.
# COLLECT_CONCURRENCY=2

# Attempts a job gets, the first included. Only rate limits, timeouts and unavailable upstreams are retried; the last such attempt dead-letters the job.
# Optional; the default is shown.
# JOB_MAX_ATTEMPTS=5

# Wait before a job's second attempt; it doubles per attempt after.
# Optional; the default is shown.
# JOB_RETRY_BASE_MS=2000

# Longest the backoff alone waits. An upstream's own Retry-After may be longer.
# Optional; the default is shown.
# JOB_RETRY_MAX_MS=300000

# Consecutive failures of one source that open its circuit.
# Optional; the default is shown.
# CIRCUIT_FAILURE_THRESHOLD=5

# A failure older than this no longer counts towards opening a circuit.
# Optional; the default is shown.
# CIRCUIT_FAILURE_WINDOW_MS=300000

# How long an open circuit refuses calls before one probe is let through.
# Optional; the default is shown.
# CIRCUIT_COOLING_MS=60000

# How long a half-open circuit's probe holds its slot; longer than any collector's run budget.
# Optional; the default is shown.
# CIRCUIT_PROBE_LEASE_MS=600000

# How often the run progress stream reads a run's state.
# Optional; the default is shown.
# RUN_EVENTS_POLL_MS=1000
