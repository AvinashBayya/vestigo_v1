# Generated from packages/config/src/env.ts — do not edit by hand.
# Regenerate with: pnpm --filter @repo/config generate:env
# Copy to .env for local development.

# Runtime mode.
# Optional; the default is shown.
# NODE_ENV=development

# Minimum level for structured logs.
# Optional; the default is shown.
# LOG_LEVEL=info

# Interface the API server binds to.
# Optional; the default is shown.
# API_HOST=127.0.0.1

# TCP port the API server listens on.
# Optional; the default is shown.
# API_PORT=3000

# PostgreSQL connection string. The example matches docker-compose.yml.
# Required.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app

# Redis connection string. The example matches docker-compose.yml.
# Required.
REDIS_URL=redis://127.0.0.1:6379

# Brave Search API key. Chosen dork-engine backend (ARCHITECTURE-DECISIONS §11).
# Optional.
BRAVE_SEARCH_API_KEY=

# Shodan paid API key. InternetDB is non-commercial only (ARCHITECTURE-DECISIONS §11).
# Optional.
SHODAN_API_KEY=

# Have I Been Pwned API key. Commercial terms not yet verified (ARCHITECTURE-DECISIONS §11).
# Optional.
HIBP_API_KEY=

# GitHub API token.
# Optional.
GITHUB_TOKEN=
