{
  "name": "@repo/worker",
  "version": "0.1.0",
  "private": true,
  "description": "One worker codebase, deployed as pools selected by queue.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/collectors": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/integrations": "workspace:*",
    "pino": "10.3.1",
    "@repo/llm": "workspace:*",
    "@repo/osint-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
