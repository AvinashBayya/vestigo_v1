{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify API. Routes only; business logic lives in packages/.",
  "type": "module",
  "exports": {
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/emit-openapi.ts",
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.0",
    "@repo/config": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.10.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
