{
  "name": "@repo/osint-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestration: dispatching collectors through the licence, entitlement and scope gates, and the one path from a collector's result to evidence rows.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/access": "workspace:*",
    "@repo/collectors": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/integrations": "workspace:*"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
