{
  "name": "@repo/integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Credential vault, API key storage and rate limits.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
