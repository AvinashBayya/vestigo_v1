{
  "name": "@repo/integrations",
  "version": "0.1.0",
  "private": true,
  "description": "Credential vault, API key storage, rate limits, circuit breakers, and report rendering and exports (PDF, JSON, CSV, Maltego).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/access": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "ioredis": "^6.0.0",
    "@repo/config": "workspace:*",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "pdfjs-dist": "6.3.289",
    "@repo/collectors": "workspace:*"
  }
}
