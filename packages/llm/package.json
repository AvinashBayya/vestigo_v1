{
  "name": "@repo/llm",
  "version": "0.1.0",
  "private": true,
  "description": "LLM provider interface, model routing, response cache, token metering, untrusted-data framing, output guards and citation validation.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "eval:live": "node --env-file-if-exists=../../.env scripts/eval-live.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "ioredis": "^6.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
