{
  "name": "@repo/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema, migrations and row-level security policies.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "generate:migration": "drizzle-kit generate",
    "migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@repo/access": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  }
}
