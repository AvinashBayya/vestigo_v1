{
  "name": "@repo/collectors",
  "version": "0.1.0",
  "private": true,
  "description": "Collector SDK, platform source catalogue, registry, licence gating and the one outbound fetcher. No database access.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/access": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/core": "workspace:*",
    "libphonenumber-js": "1.13.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
